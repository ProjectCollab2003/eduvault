-- ============================================================
-- 13. INDEXES
-- ============================================================

CREATE INDEX idx_subjects_grade_id
ON subjects(grade_id);

CREATE INDEX idx_materials_subject_id
ON materials(subject_id);

CREATE INDEX idx_materials_category_id
